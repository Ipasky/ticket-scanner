# Clave de API de Google Gemini. Obténla en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelos de Gemini, en una LISTA ORDENADA separada por comas: del preferido al
# de respaldo. Sustituye a GEMINI_MODEL (que se sigue leyendo si esta no esta,
# para no romper un .env antiguo: un modelo es una lista de uno).
#
#     GEMINI_MODELOS=gemini-2.5-pro,gemini-flash-latest
#
# Por que una lista y no un modelo:
#   - Las cuotas y la saturacion son POR MODELO. Ante un 503 o un 429, cambiar de
#     modelo es la unica reaccion que puede salvar la peticion; esperar no sirve
#     cuando la cuota esta agotada.
#   - Calidad contra precio es una decision por foto, no del despliegue: desde la
#     web se puede forzar "Mejor" (el primero) o "Rapido" (el ultimo).
#
# Que hace la cascada con cada fallo:
#   503/500  agota los reintentos del modelo actual y pasa al siguiente
#   429      pasa al siguiente INMEDIATAMENTE (la cuota no se renueva en segundos)
#   404      pasa al siguiente y avisa de que ese nombre no existe
#   401/403  NO pasa: la clave es la misma para todos
#   otros    NO pasa: daria el mismo resultado
#
# src/check_models.js lista los modelos disponibles para tu clave.
GEMINI_MODELOS=

# Obsoleta: usa GEMINI_MODELOS. Se sigue leyendo como respaldo.
GEMINI_MODEL=

# Puerto en el que escuchará el servidor Express en local (por ejemplo: 3000).
PORT=

# Tope de tokens de salida por peticion a Gemini (opcional).
# Vacio = 65536, el techo de las familias Gemini 2.5 y posteriores. El
# presupuesto se comparte con los tokens de razonamiento del modelo, asi que una
# foto con varios tiquets necesita margen: con 8192 la respuesta llega truncada.
# Si alguno de los modelos de GEMINI_MODELOS admite menos, la API responde 400:
# baja esto a 8192, que es seguro para cualquier modelo. Un 400 NO salta al
# modelo siguiente a proposito: es configuracion tuya y el mensaje dice que bajar;
# taparlo con el modelo de respaldo esconderia el problema sin resolverlo.
GEMINI_MAX_OUTPUT_TOKENS=

# Tamano maximo de un archivo subido, en MB (opcional). Vacio = 100.
#
# El original se guarda SIEMPRE tal cual: ni se recomprime ni se redimensiona,
# asi que el tope es una decision tuya (el disco) y no un limite tecnico. Lo que
# no cabe incrustado en una peticion a Gemini (unos 14 MB, por el inflado del
# base64 y el tope de 20 MB por peticion) se le manda por su Files API y se
# BORRA de Google en cuanto termina el analisis, vaya bien o mal.
SUBIDA_MAX_MB=

# ═══════════════════════════════════════════════════════════════════════════
# GEOCODIFICACION (mapa del panel de finanzas)
# ═══════════════════════════════════════════════════════════════════════════
# Las coordenadas de cada establecimiento se piden a Nominatim (OpenStreetMap),
# en segundo plano y NUNCA durante la subida de un tiquet. Cada establecimiento
# se pregunta UNA sola vez: el resultado se guarda en la propia tabla
# (geo_estado), asi que la cache no caduca ni se pierde al reiniciar.
#
# User-Agent identificativo. OBLIGATORIO: sin el, la geocodificacion NO SE
# ACTIVA y el mapa se queda sin puntos. La politica de uso de Nominatim exige
# que cada cliente se identifique, y mandar peticiones anonimas es la forma mas
# rapida de que te bloqueen la IP. Pon que es esto y como contactarte:
#
#     NOMINATIM_USER_AGENT=ticket-scanner/1.0 (tu-correo@ejemplo.tld)
#
# Es mejor no tener coordenadas que abusar de un servicio gratuito mantenido
# por voluntarios, asi que el valor por defecto es "desactivado".
NOMINATIM_USER_AGENT=

# Correo de contacto (opcional). Nominatim lo recomienda para poder avisar antes
# de bloquear a nadie. Viaja como parametro en cada peticion.
NOMINATIM_EMAIL=

# URL del servicio (opcional). Vacio = https://nominatim.openstreetmap.org/search
# Cambialo si montas tu propia instancia: con una instancia propia no hay limite
# de una peticion por segundo, pero el codigo lo respeta igualmente.
NOMINATIM_URL=

# Pais al que acotar las busquedas (opcional, recomendado). Sin esto, una calle
# sin ciudad puede resolverse en cualquier parte del mundo. Se anade tal cual al
# final de la consulta:
#
#     GEO_PAIS=Espana
GEO_PAIS=

# La busqueda es ESCALONADA: si la direccion completa no se encuentra, se prueba
# la calle sin numero, luego el codigo postal y por ultimo la localidad. Se
# guarda con que precision se consiguio (exacta / calle / zona / localidad), y el
# mapa pinta distinto las aproximadas. Un establecimiento con coordenadas pegadas
# a mano tiene precision "manual" y NO lo toca nunca la geocodificacion
# automatica, ni al cambiar la direccion.

# Para geocodificar de golpe lo que ya tienes guardado:
#
#     npm run geocodificar
#
# Va a una peticion por segundo, asi que con muchos establecimientos tarda. Se
# puede parar con Ctrl+C y retomar: lo resuelto no se vuelve a preguntar.

# ═══════════════════════════════════════════════════════════════════════════
# AUTENTICACION
# ═══════════════════════════════════════════════════════════════════════════
# La FUENTE DE IDENTIDAD es conmutable. El middleware que protege las rutas es
# el mismo en los dos modos; lo unico que cambia es de donde sale la identidad.
# No hay valor por defecto: si falta AUTH_MODE el servidor ABORTA al arrancar,
# porque elegir uno por ti seria tomar una decision de seguridad a tus espaldas.
#
#   proxy  MODO PRINCIPAL. La identidad la valida un portal (Authelia) delante
#          del servicio y llega en una cabecera HTTP. La aplicacion no gestiona
#          contrasenas, no tiene login y no cierra sesion: eso es del portal.
#   local  Sesion propia con contrasena y cookie firmada. SOLO para desarrollo
#          en el portatil, donde no hay portal delante.
AUTH_MODE=proxy

# Nombre del usuario unico del modo local. NO se escribe en el login (no hay
# campo de usuario): es la etiqueta que queda en la sesion. Vacio = "admin".
# En modo proxy no se usa: el usuario lo dice la cabecera.
AUTH_USUARIO=

# ─── Solo en AUTH_MODE=proxy ───────────────────────────────────────────────
#
#     LO PRIMERO QUE HAY QUE ENTENDER: una cabecera HTTP la puede escribir
#     cualquiera. Confiar en ella solo es seguro si NADIE puede llegar a este
#     puerto sin pasar por el portal; con el puerto accesible, un
#     `curl -H "Remote-User: quien-sea"` entra como quien quiera. La VPN protege
#     el perimetro, NO separa la aplicacion del portal.
#
# OBLIGATORIA en modo proxy: lista de IPs/redes, separadas por comas, desde las
# que se aceptan peticiones. Lo que venga de otro sitio recibe un 403 aunque
# traiga la cabecera. El origen se toma del socket (no de X-Forwarded-For, que
# tambien es una cabecera), asi que no se puede falsificar desde fuera.
# Es defensa en profundidad: el cortafuegos y la NetworkPolicy ya deberian
# impedir que nadie mas alcance el puerto.
#
#   En el cluster K3s, la red de pods:   10.42.0.0/16
#   Contra un proxy en la misma maquina: 127.0.0.1,::1
#
# Se admiten IPs sueltas y redes CIDR, IPv4 e IPv6. Una entrada que no se
# entienda ABORTA el arranque: en una lista de control de acceso, ignorar lo que
# no se entiende acaba abriendo o cerrando de mas, y sin avisar.
# Nota: /ping queda fuera de esta comprobacion a proposito, porque las sondas de
# Kubernetes salen de la IP del nodo y no de la red de pods.
AUTH_PROXY_IPS_PERMITIDAS=10.42.0.0/16

# Nombre de la cabecera donde el portal pone el usuario ya autenticado.
# Vacio = Remote-User, que es la de Authelia. Aqui si hay valor por defecto, y a
# diferencia de la lista de IPs no es una decision de seguridad: equivocarse con
# el nombre no abre nada, solo impide que se autentique alguien.
#
#     Authelia              Remote-User      (por defecto)
#     oauth2-proxy          X-Forwarded-User
#     Cloudflare Access     Cf-Access-Authenticated-User-Email
#     Traefik forward-auth  depende de tu configuracion
AUTH_PROXY_HEADER=

# Cabeceras opcionales con el correo y el nombre, para poder mostrar quien esta
# conectado. Vacias = Remote-Email y Remote-Name (Authelia). Si el portal no las
# manda, no pasa nada: la identidad es el usuario.
AUTH_PROXY_HEADER_EMAIL=
AUTH_PROXY_HEADER_NOMBRE=

# URL del portal. Es a donde se manda a quien llega sin identidad: el frontend
# ante un 401 y el servidor ante una navegacion sin cabecera. Opcional; sin ella
# se cae en /sin-identidad.html, que explica lo que ha pasado.
# Solo se admiten http://, https:// o una ruta que empiece por "/": ese valor
# acaba en un redirect y en un href, y admitir cualquier esquema seria abrir un
# agujero en casa. Un valor con otro esquema ABORTA el arranque.
AUTH_PORTAL_URL=

# URL de cierre de sesion del portal. La aplicacion NO implementa cierre de
# sesion propio en modo proxy: la sesion es del portal y cerrarla aqui seria
# mentir (la siguiente peticion volveria a traer la cabecera). Con esto puesto,
# el frontend ensena un enlace "Salir del portal"; sin ella, no ensena nada.
#
#     Authelia: https://auth.tudominio.tld/logout
AUTH_LOGOUT_URL=

# ─── Solo en AUTH_MODE=local (desarrollo) ──────────────────────────────────
# Aqui va el HASH de la contrasena, NUNCA la contrasena. Generalo con:
#
#     npm run hash-password
#
# y pega la linea completa que imprime. Es scrypt del modulo crypto de Node (no
# bcrypt ni argon2: son modulos nativos y habria que compilarlos para arm64).
AUTH_PASSWORD_HASH=

# Secreto con el que se firma la cookie de sesion. Minimo 32 caracteres. Sin el,
# cualquiera podria fabricarse una cookie valida. Cambiarlo cierra todas las
# sesiones abiertas (es la unica forma de revocarlas: no hay almacen en servidor).
# Generalo con:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# secure=true hace que el navegador mande la cookie SOLO por HTTPS.
# Dejalo vacio (= false) si entras por HTTP, que es el caso del portatil.
# Si lo activas sin HTTPS, el login "no hace nada": el navegador descarta la
# cookie sin decir nada.
AUTH_COOKIE_SECURE=

# No hay limitacion de intentos ni registro de fallidos en modo local, y es
# deliberado: ese modo solo existe en el portatil. En produccion la aplicacion va
# detras del portal, que es quien ve los intentos de verdad y quien los cuenta.

# --- GOOGLE MAPS PLATFORM -------------------------------------------------------
# Dos claves distintas, creadas en Google Cloud (APIs y servicios > Credenciales):
#   GOOGLE_PLACES_API_KEY  la usa el SERVIDOR para verificar establecimientos.
#                          Restricción de API: solo "Places API (New)".
#   GOOGLE_MAPS_API_KEY    la usa el NAVEGADOR para pintar el mapa (es visible).
#                          Restricción de API: solo "Maps JavaScript API".
#                          Restricción de sitio web: el dominio de la app.
# Sin ellas, la app funciona igual: sin verificación y sin mapa.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
# Opcional: un Map ID propio (Google Cloud > Gestión de mapas) para el estilo.
# Sin él se usa DEMO_MAP_ID, que vale para empezar.
GOOGLE_MAPS_MAP_ID=

# --- BANCO (Enable Banking, solo lectura) --------------------------------------
# Id de la aplicación (el nombre del .pem sin la extensión) y ruta a la clave
# privada que descargó el navegador al registrarla. La carpeta keys/ está en el
# .gitignore. En la Pi, la clave va como secreto de K3s.
ENABLEBANKING_APP_ID=
ENABLEBANKING_KEY_PATH=keys/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.pem
# A dónde vuelve el navegador tras autorizar en el banco. Tiene que ser EXACTAMENTE
# la que se registró en Enable Banking. Sin ella: http://localhost:3000/banco/vuelta
BANCO_REDIRECT_URL=https://tiquetscan.<tu-dominio>/banco/vuelta
# Banco y país (opcionales)
BANCO_ASPSP=Santander
BANCO_PAIS=ES
