{
  "name": "ticket-scanner",
  "version": "0.1.0",
  "description": "Escáner de tiquets con extracción de datos vía Gemini y almacenamiento en SQLite.",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
