    "iconos": "node scripts/generar_iconos.js",
    "geocodificar": "node scripts/geocodificar.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@google/genai": "latest",
    "better-sqlite3": "latest",
    "dotenv": "latest",
    "express": "latest",
    "multer": "latest"
  }
}
